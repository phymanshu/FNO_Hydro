!EPOS4 Pb-Pb 30-50% centrality 5.36 TeV
application hadron
set laproj 82
set maproj 208
set latarg 82
set matarg 208
set ecms 5360
set istmax 25
set iranphi 1
ftime on
nodecays 110 20 2130 -2130 2230 -2230 1130 -1130 1330 -1330 2330 -2330 3331 -3331 end
core full
hydro hlle
eos x3ff
hacas full
set ninicon 1
set nfull 1
set nfreeze 1
set modsho 1
set bminim 4.57
set bmaxim 5.89
set ihepmc 1
